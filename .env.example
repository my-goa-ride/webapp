# Copy to .env.local for local development, and set the same values where the site is hosted.
# The booking and contact forms publish to this SNS topic (see app/actions/enquiry.ts).

SNS_REGION=ap-south-1
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:car-enquiries

# An IAM user that can only call sns:Publish on the topic above.
# Leave both empty if the host provides an AWS role with that permission instead.
SNS_ACCESS_KEY_ID=
SNS_SECRET_ACCESS_KEY=
